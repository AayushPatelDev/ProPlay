# Copy this file to backend/.env and fill in your key:  cp .env.example .env
# Get a key at https://dashboard.api-football.com (header: x-apisports-key)
API_KEY=""

# API-Football v3 base URL (direct API-Sports account). Leave as-is unless you use RapidAPI.
API_BASE_URL="https://v3.football.api-sports.io"

# 39 = English Premier League
LEAGUE_ID=39

# Season = starting year (2023 => 2023/24). The free plan only allows a limited
# range of seasons; run `python -m app.fetch_data --status` to see your plan.
SEASONS="2022,2023,2024"

# Free plan: 10 requests/minute, 100/day. 6.5s spacing keeps you under the per-minute cap.
REQUEST_INTERVAL_SECONDS=6.5

# Free plan rejects page > 3; players are fetched per club to stay within it.
MAX_PAGES_PER_QUERY=3

# Where market value labels come from:
#   auto      -> data/market_values.csv if it exists, otherwise synthetic
#   csv       -> only real labels from data/market_values.csv (unmatched players dropped)
#   synthetic -> deterministic, formula-based placeholder values (demo only)
LABEL_MODE="auto"

CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
